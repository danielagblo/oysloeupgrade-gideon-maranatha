{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": false,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["tests", "dist", "node_modules", "coverage"]
}
