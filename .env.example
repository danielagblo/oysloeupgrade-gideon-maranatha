# Development Environment Configuration
NODE_ENV=your_value_here
PORT=your_value_here
API_VERSION=your_value_here

# Database
DB_HOST=your_value_here
DB_PORT=your_value_here
DB_NAME=your_value_here
DB_USER=your_value_here
DB_PASSWORD=your_value_here
DB_LOGGING=your_value_here

# Redis
REDIS_HOST=your_value_here
REDIS_PORT=your_value_here
REDIS_PASSWORD=your_value_here

# JWT Authentication
JWT_SECRET=your_value_here
JWT_EXPIRY=your_value_here

# File Storage (Local)
STORAGE_TYPE=your_value_here
UPLOAD_DIR=your_value_here

# Firebase Cloud Messaging (FCM) - Production credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_FIREBASE_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email@your_project.iam.gserviceaccount.com

# SMS Provider - Arkesel (Required for OTP)
ARKESEL_API_KEY=your_value_here
SMS_SENDER_ID=your_value_here

# Cloudinary 
CLOUDINARY_CLOUD_NAME=your_value_here
CLOUDINARY_API_KEY=your_value_here
CLOUDINARY_API_SECRET=your_value_here
CLOUDINARY_UPLOAD_PRESET_PRODUCTS=your_value_here
CLOUDINARY_UPLOAD_PRESET_AVATARS=your_value_here
CLOUDINARY_ROOT_FOLDER=your_value_here
CLOUDINARY_ENV_TAG=your_value_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=your_value_here
RATE_LIMIT_MAX_REQUESTS=your_value_here
OTP_RATE_LIMIT_MAX=your_value_here

# Logging
LOG_LEVEL=your_value_here
LOG_FILE_PATH=your_value_here

# CORS (WebSocket and API)
CORS_ORIGIN=your_value_here

# Google OAuth (Required for social login)
GOOGLE_CLIENT_ID=your_value_here
GOOGLE_CLIENT_SECRET=your_value_here
GOOGLE_CALLBACK_URL=your_value_here

# Session Secret (Required for OAuth sessions)
SESSION_SECRET=your_value_here

# UUID Namespace (Optional - uses default if not set)
UUID_NAMESPACE=your_value_here
