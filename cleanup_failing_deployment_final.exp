#!/usr/bin/expect -f

set timeout 30

spawn ssh -o StrictHostKeyChecking=no root@207.154.219.165
expect "password:"
send "qazRyb-kexfy6-ketken\r"
expect "# "

send "cd ~/oysloeupgrade-gideon-maranatha-main/backend\r"
expect "# "

send "echo '=== STOPPING AND REMOVING FAILING APP CONTAINER ==='\r"
expect "# "
send "docker-compose -f docker-compose.prod.yml down --remove-orphans\r"
expect "# "

send "echo '=== REMOVING UNUSED DOCKER RESOURCES ==='\r"
expect "# "
send "docker system prune -f\r"
expect "# "

send "echo '=== REMOVING DANGLING IMAGES ==='\r"
expect "# "
send "docker image prune -f\r"
expect "# "

send "echo '=== CLEANING UP SYSTEM CACHE ==='\r"
expect "# "
send "apt autoremove -y\r"
expect "# "
send "apt autoclean -y\r"
expect "# "

send "echo '=== CHECKING CURRENT DOCKER CONTAINERS (DB AND REDIS SHOULD STILL BE RUNNING) ==='\r"
expect "# "
send "docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'\r"
expect "# "

send "echo '=== CHECKING DISK SPACE ==='\r"
expect "# "
send "df -h\r"
expect "# "

send "echo '=== REMOVING TEMP FILES AND CLEANING UP ==='\r"
expect "# "
send "cd ~\r"
expect "# "
send "rm -rf main.zip* on-maranatha-main\r"
expect "# "
send "ls -la\r"
expect "# "

send "echo 'Cleanup completed. Database and Redis containers should still be running.'\r"
expect "# "
send "echo 'Ready for fresh deployment with your fixes.'\r"
expect "# "

send "exit\r"
expect eof
