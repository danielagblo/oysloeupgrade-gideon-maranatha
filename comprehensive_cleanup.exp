#!/usr/bin/expect -f

set timeout 30

spawn ssh -o StrictHostKeyChecking=no root@207.154.219.165
expect "password:"
send "qazRyb-kexfy6-ketken\r"
expect "# "

send "cd ~/oysloeupgrade-gideon-maranatha-main/backend\r"
expect "# "

send "echo '=== CHECKING CURRENT DISK SPACE ==='\r"
expect "# "
send "df -h\r"
expect "# "

send "echo '=== CHECKING DOCKER SYSTEM USAGE ==='\r"
expect "# "
send "docker system df\r"
expect "# "

send "echo '=== CHECKING RUNNING CONTAINERS ==='\r"
expect "# "
send "docker ps -a --format 'table {{.Names}}\t{{.Status}}\t{{.Size}}'\r"
expect "# "

send "echo '=== STOPPING AND REMOVING NON-ESSENTIAL CONTAINERS ==='\r"
expect "# "
send "docker stop oysloe-backend-prod 2>/dev/null || echo 'No app container to stop'\r"
expect "# "
send "docker rm oysloe-backend-prod 2>/dev/null || echo 'No app container to remove'\r"
expect "# "

send "echo '=== REMOVING UNUSED DOCKER RESOURCES ==='\r"
expect "# "
send "docker system prune -f\r"
expect "# "

send "echo '=== REMOVING DANGLING IMAGES ==='\r"
expect "# "
send "docker image prune -f\r"
expect "# "

send "echo '=== REMOVING UNUSED VOLUMES (EXCEPT DB DATA) ==='\r"
expect "# "
send "docker volume ls\r"
expect "# "
send "docker volume prune -f\r"
expect "# "

send "echo '=== CLEANING UP SYSTEM CACHE ==='\r"
expect "# "
send "apt autoremove -y\r"
expect "# "
send "apt autoclean -y\r"
expect "# "

send "echo '=== REMOVING TEMPORARY FILES ==='\r"
expect "# "
send "cd ~\r"
expect "# "
send "rm -rf /tmp/* 2>/dev/null || echo 'No temp files to clean'\r"
expect "# "
send "rm -rf ~/.cache/* 2>/dev/null || echo 'No cache files to clean'\r"
expect "# "
send "find /var/log -type f -name '*.log' -exec truncate -s 0 {} \; 2>/dev/null || echo 'No log files to truncate'\r"
expect "# "

send "echo '=== VERIFYING DB AND REDIS CONTAINERS ARE STILL RUNNING ==='\r"
expect "# "
send "docker ps --filter 'name=postgres|redis' --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'\r"
expect "# "

send "echo '=== CHECKING DATA VOLUMES ==='\r"
expect "# "
send "docker volume ls | grep -E '(postgres|redis)'\r"
expect "# "

send "echo '=== FINAL DISK SPACE CHECK ==='\r"
expect "# "
send "df -h\r"
expect "# "

send "echo '=== DOCKER SYSTEM USAGE AFTER CLEANUP ==='\r"
expect "# "
send "docker system df\r"
expect "# "

send "echo 'Cleanup completed! Database and Redis containers preserved.'\r"
expect "# "

send "exit\r"
expect eof
